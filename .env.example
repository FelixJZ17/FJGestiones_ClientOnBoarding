FLASK_HOST=127.0.0.1
FLASK_PORT=5000
DATABASE_PATH=data/submissions.sqlite3

# Producción: crea un proyecto Supabase y ejecuta supabase_schema.sql.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_solo_en_backend

# Gmail: usa una contraseña de aplicación, no tu contraseña normal.
MAIL_USERNAME=ejemplo@gmail.com
MAIL_PASSWORD=pon aquí tu contraseña generada en tu cuenta de gmail - 16 caracteres
MAIL_TO=ejemplo@gmail.com

# En producción debe ser la URL pública exacta de la web.
ALLOWED_ORIGIN=http://127.0.0.1:5000

# Local: memory://. Producción: usa la URL Redis de Upstash/Vercel Marketplace.
RATELIMIT_STORAGE_URI=memory://

# Salt aleatorio para no guardar la IP real en SQLite.
IP_HASH_SALT=cambia-este-valor
